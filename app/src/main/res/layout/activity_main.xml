<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorPrimary"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛠"
            android:textSize="20sp"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/colorAccent"
        android:padding="20dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:text="🔧"
            android:textSize="32sp"
            android:gravity="center"
            android:background="@color/colorBackground"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sistema Gerenciador\nde Ferramentas"
            android:textColor="@color/colorTextOnAccent"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Escolha uma das opções abaixo:"
        android:textSize="18sp"
        android:textColor="@color/colorPrimary"
        android:padding="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <Button
            android:id="@+id/btnCadastrar"
            style="@style/BotaoMenu"
            app:backgroundTint="@null"
            android:text="Cadastrar Ferramenta"/>

        <Button
            android:id="@+id/btnAlterar"
            style="@style/BotaoMenu"
            app:backgroundTint="@null"
            android:text="Alterar Dados"/>

        <Button
            android:id="@+id/btnConsultar"
            style="@style/BotaoMenu"
            app:backgroundTint="@null"
            android:text="Consultar Ferramenta"/>

        <Button
            android:id="@+id/btnExcluir"
            style="@style/BotaoMenu"
            app:backgroundTint="@null"
            android:text="Excluir Ferramenta"/>

    </LinearLayout>

</LinearLayout>
